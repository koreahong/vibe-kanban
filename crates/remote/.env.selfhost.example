# Database
DB_PASSWORD=vibekanban
ELECTRIC_ROLE_PASSWORD=vibekanban

# JWT Secret (REQUIRED — generate with: openssl rand -base64 48)
VIBEKANBAN_REMOTE_JWT_SECRET=

# Public URL where the server is accessible from browsers
PUBLIC_BASE_URL=http://localhost:3000

# Dev Auth — enables login without OAuth providers
VIBEKANBAN_DEV_AUTH=true

# Keycloak OIDC (optional — for enterprise SSO)
# KEYCLOAK_URL=https://auth.example.com
# KEYCLOAK_REALM=master
# KEYCLOAK_CLIENT_ID=vibe-kanban
# KEYCLOAK_CLIENT_SECRET=
